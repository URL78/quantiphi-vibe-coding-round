# GitHub Personal Access Token (optional but recommended for GraphQL/higher rate limits)
# Create at: https://github.com/settings/tokens  (scope: read:user)
GITHUB_TOKEN=

# SQLite database path (relative to backend/)
DATABASE_URL=sqlite:///./portfolio.db

# DeepWiki MCP server endpoint
DEEPWIKI_MCP_URL=https://mcp.deepwiki.com/mcp

# Frontend origin for CORS
FRONTEND_URL=http://localhost:5173

# Cache TTL in seconds (defaults shown)
# PROFILE_CACHE_TTL=3600
# REPO_CACHE_TTL=3600
# CONTRIBUTION_CACHE_TTL=21600
